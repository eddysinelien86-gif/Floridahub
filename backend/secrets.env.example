# Copy this file to  secrets.env  and fill in your values.
#   cp secrets.env.example secrets.env
# secrets.env is gitignored, so your password/key never get committed.

# Dashboard login (lead form stays public regardless)
MARKETHUB_USER=admin
MARKETHUB_PASSWORD=change-me

# Optional: real AI posts. Get a key at console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
MARKETHUB_MODEL=claude-haiku-5-5
MARKETHUB_BRAND=Insulation Lead Finders

# Free local AI (Ollama on this Pi). Used when no ANTHROPIC_API_KEY is set, or
# if the Claude call fails. Set the model to "off" to disable it.
# MARKETHUB_OLLAMA_MODEL=llama3.2:3b
# OLLAMA_HOST=http://127.0.0.1:11434

# Scheduler: hours between automatic draft runs (0 = off)
MARKETHUB_AUTODRAFT_HOURS=24

# Your permanent public address (set once you have a domain + named tunnel).
# The dashboard QR + link auto-point here. Example:
# MARKETHUB_PUBLIC_URL=https://leads.floridainsulationleads.com

# Email alerts on every new lead. For Gmail, SMTP_PASS is an "App Password"
# (Google Account > Security > 2-Step Verification > App passwords), NOT your
# normal password. Leave blank to disable alerts.
# ALERT_TO=you@gmail.com
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
